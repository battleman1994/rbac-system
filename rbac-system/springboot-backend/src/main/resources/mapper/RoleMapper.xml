<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rbac.mapper.RoleMapper">
    
    <resultMap id="roleWithPermissionsMap" type="com.rbac.entity.Role">
        <id column="id" property="id"/>
        <result column="role_name" property="roleName"/>
        <result column="role_code" property="roleCode"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <collection property="permissions" ofType="com.rbac.entity.Permission">
            <id column="perm_id" property="id"/>
            <result column="permission_name" property="permissionName"/>
            <result column="permission_code" property="permissionCode"/>
            <result column="type" property="type"/>
        </collection>
    </resultMap>
    
    <select id="selectRolesByUserId" resultType="com.rbac.entity.Role">
        SELECT r.* FROM sys_role r
        INNER JOIN sys_user_role ur ON r.id = ur.role_id
        WHERE ur.user_id = #{userId}
    </select>
    
    <select id="selectAllWithPermissions" resultMap="roleWithPermissionsMap">
        SELECT 
            r.*,
            p.id as perm_id,
            p.permission_name,
            p.permission_code,
            p.type
        FROM sys_role r
        LEFT JOIN sys_role_permission rp ON r.id = rp.role_id
        LEFT JOIN sys_permission p ON rp.permission_id = p.id
    </select>
    
    <select id="selectByIdWithPermissions" resultMap="roleWithPermissionsMap">
        SELECT 
            r.*,
            p.id as perm_id,
            p.permission_name,
            p.permission_code,
            p.type
        FROM sys_role r
        LEFT JOIN sys_role_permission rp ON r.id = rp.role_id
        LEFT JOIN sys_permission p ON rp.permission_id = p.id
        WHERE r.id = #{id}
    </select>
</mapper>
