<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rbac.mapper.PermissionMapper">
    
    <resultMap id="permissionTreeMap" type="com.rbac.entity.Permission">
        <id column="id" property="id"/>
        <result column="permission_name" property="permissionName"/>
        <result column="permission_code" property="permissionCode"/>
        <result column="type" property="type"/>
        <result column="parent_id" property="parentId"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="icon" property="icon"/>
        <result column="path" property="path"/>
        <result column="component" property="component"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>
    
    <select id="selectPermissionsByRoleId" resultType="com.rbac.entity.Permission">
        SELECT p.* FROM sys_permission p
        INNER JOIN sys_role_permission rp ON p.id = rp.permission_id
        WHERE rp.role_id = #{roleId} AND p.status = 1
        ORDER BY p.sort_order
    </select>
    
    <select id="selectPermissionsByRoleIds" resultType="com.rbac.entity.Permission">
        SELECT DISTINCT p.* FROM sys_permission p
        INNER JOIN sys_role_permission rp ON p.id = rp.permission_id
        WHERE rp.role_id IN
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
        AND p.status = 1
        ORDER BY p.sort_order
    </select>
    
    <select id="selectAllMenuTree" resultMap="permissionTreeMap">
        SELECT * FROM sys_permission WHERE status = 1 ORDER BY sort_order
    </select>
    
    <select id="selectChildrenByParentId" resultType="com.rbac.entity.Permission">
        SELECT * FROM sys_permission WHERE parent_id = #{parentId} AND status = 1 ORDER BY sort_order
    </select>
</mapper>
